---
import Book from './Book.astro';
import {courseLessons,lessonPath,type CourseId} from '../courses';
import type { Language } from '../i18n';
interface StoryText { title: string; summary: string; whyItMatters: string; }
interface Issue {
 updatedAt: string; windowStart: string; windowEnd: string;
 stories: { id: string; publishedAt: string; source: { name: string; url: string }; lessons: {course:string;id:string}[]; en: StoryText; ko: StoryText }[];
}
interface Props { lang?: Language; issue: Issue; }
const { lang='en', issue } = Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+(lang==='ko'?'/ko':'');
const related=new Map(await Promise.all(issue.stories.map(async story=>[story.id,await Promise.all(story.lessons.map(async ref=>{
 const course=ref.course as CourseId;
 const lesson=(await courseLessons(course,lang)).find(l=>l.id===ref.id);
 if(!lesson) throw new Error(`Missing prerequisite lesson: ${lang}/${course}/${ref.id}`);
 return {title:lesson.data.title,href:`${base}/${lessonPath(course,ref.id)}`};
}))] as const)));
const title = lang === 'ko' ? 'AI 뉴스' : 'AI News';
const description = lang === 'ko' ? '직접 활용할 수 있는 AI 도구, 스킬, 기법을 매주 세 가지씩 소개합니다.' : 'Three useful AI tools, skills, and techniques to explore each week.';
const updatedDate = new Intl.DateTimeFormat('en-CA', {
 timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit'
}).format(new Date(issue.updatedAt));
const headings = issue.stories.map(story => ({ depth: 2, slug: story.id, text: story[lang].title }));
---
<Book title={title} description={description} lang={lang} section="news" headings={headings}>
 <h1>{title}</h1>
 <p class="news-schedule">{lang === 'ko' ? '매주 일요일 오전 8시 (한국 시간)' : 'Weekly · Sunday 08:00 KST'}</p>
 <p class="lead">{description}</p>
 <p class="news-selection">{lang==='ko'?'일요일 오전 8시에 자료 조사를 시작합니다. 검증과 배포가 끝난 뒤 업데이트되므로 실제 게시 시각은 달라질 수 있습니다.':'Research starts Sunday at 08:00 KST. Publication follows verification and deployment; the actual update time may vary.'}</p>
 <div class="news-issue">
  <p>{lang === 'ko' ? '업데이트' : 'Updated'}: <time datetime={issue.updatedAt}>{updatedDate}</time></p>
  <p>{lang === 'ko' ? '소식 선정 기간' : 'Coverage'}: <time datetime={issue.windowStart}>{issue.windowStart}</time> {lang==='ko'?'부터':'to'} <time datetime={issue.windowEnd}>{issue.windowEnd}</time></p>
  <p>{lang === 'ko' ? '업데이트·선정 기간: 한국 시간 (Asia/Seoul). 원문 게시일은 출처의 날짜를 따릅니다.' : 'Update and coverage use Asia/Seoul (KST). Publication dates follow the source.'}</p>
 </div>
 <p class="news-selection">{lang === 'ko'
  ? '이번 주에 공개되거나 갱신된 실용적인 도구와 학습 자료를 선정합니다. 기업 발표나 정책 논쟁보다 활용 사례를 우선하며, 객관적인 순위가 아닙니다. 인기 상승을 확인할 근거가 없다면 유행이라고 부르지 않습니다. 아래 실습 제안은 편집자의 판단입니다.'
  : 'We select practical releases and learning resources published or updated this week—not corporate headlines or policy debates. This is an editorial selection, not an objective ranking. We only describe a tool as trending when dated adoption evidence supports it. Suggested experiments below are editorial advice.'}</p>
 <div class="news-stories prose">
  {issue.stories.map((story, index) => <article id={story.id} class="news-story" aria-labelledby={`${story.id}-title`}>
   <p class="news-published">{lang === 'ko' ? '원문 게시일' : 'Originally published'} / <time datetime={story.publishedAt}>{story.publishedAt}</time></p>
   <h2 id={`${story.id}-title`}>{story[lang].title}</h2>
   <p>{story[lang].summary}</p>
   <p class="news-source"><a href={story.source.url}>[{index + 1}] {story.source.name}</a> <span>{lang === 'ko' ? '원문 읽기' : 'Read the original'}</span></p>
   <p class="news-perspective"><strong>{lang === 'ko' ? '편집자 해설 — 이렇게 활용해 보세요' : 'Editorial perspective — try it in practice'}</strong><br/>{story[lang].whyItMatters}</p>
   <nav class="story-lessons" aria-label={lang==='ko'?'이 소식을 이해하는 데 필요한 강의':'Understand this story'}>
    <h3>{lang==='ko'?'이 소식을 이해하는 데 필요한 강의':'Understand this story'}</h3>
    <ul>{related.get(story.id)?.map(lesson=><li><a href={lesson.href}>{lesson.title}<span aria-hidden="true">↗</span></a></li>)}</ul>
   </nav>
  </article>)}
 </div>
</Book>
