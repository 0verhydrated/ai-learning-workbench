---
import {getCollection, render} from 'astro:content';
import Book from '../../layouts/Book.astro';
export async function getStaticPaths(){const lessons=(await getCollection('lessons')).sort((a,b)=>a.data.order-b.data.order);return lessons.map((lesson,i)=>({params:{id:lesson.id},props:{lesson,prev:lessons[i-1],next:lessons[i+1]}}));}
const {lesson,prev,next}=Astro.props;
const {Content,headings}=await render(lesson);
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<Book title={lesson.data.title} description={lesson.data.description} current={lesson.id} headings={headings}>
<div class="eyebrow">{lesson.data.part} <span> / </span> LESSON {String(lesson.data.order).padStart(2,'0')}</div>
<h1 class="lesson-title">{lesson.data.title}</h1><p class="lead">{lesson.data.description}</p><div class="lesson-meta">{lesson.data.duration} read <span>·</span> Includes a practical exercise</div>
<article class="prose"><Content/></article>
<nav class="pagination" aria-label="Lesson navigation"><a href={prev?`${base}/lessons/${prev.id}/`:`${base}/`}><small>PREVIOUS</small>← {prev?.data.title??'Introduction'}</a>{next?<a href={`${base}/lessons/${next.id}/`}><small>NEXT LESSON</small>{next.data.title} →</a>:<a href={`${base}/#curriculum`}><small>COURSE COMPLETE</small>Return to the curriculum →</a>}</nav>
</Book>
