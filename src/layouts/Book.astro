---
import { courses, courseIds, courseLessons, lessonPath, type CourseId } from '../courses';
import { ui, parts, type Language } from '../i18n';
import '../styles/book.css';
import '../styles/courses.css';
interface Props { title: string; description: string; current?: string; section?: 'book' | 'news' | 'catalog'; course?: CourseId; lang?: Language; headings?: {depth:number;slug:string;text:string}[]; }
const {title, description, current='', section='book', course='vibe-coding', lang='en', headings=[]} = Astro.props;
const newsTitle = lang === 'ko' ? 'AI 뉴스' : 'AI News';
const t = ui[lang];
const lessons = section==='book' ? await courseLessons(course,lang) : [];
const courseTitle=courses[course][lang].title;
const catalogTitle=lang==='ko'?'전체 과정':'All courses';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}/${lang === 'ko' ? 'ko/' : ''}${path}`;
const pagePath = section==='news' ? 'news/' : section==='catalog' ? '' : current ? lessonPath(course,current) : `courses/${course}/`;
const enUrl = `${base}/${pagePath}`;
const koUrl = `${base}/ko/${pagePath}`;
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
 <meta name="description" content={description}/><meta name="theme-color" content="#faf9f6"/>
 <title>{title} · {t.book}</title><link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml"/>
 <link rel="canonical" href={new URL(lang === 'ko' ? koUrl : enUrl, Astro.site)}/>
 <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.site)}/>
 <link rel="alternate" hreflang="ko" href={new URL(koUrl, Astro.site)}/>
 <link rel="alternate" hreflang="x-default" href={new URL(enUrl, Astro.site)}/>
</head>
<body>
<a class="skip" href="#main">{t.skip}</a>
<div class="mobile-bar"><a href={link('')}>{t.book}</a><button id="menu-toggle" aria-expanded="false" aria-controls="sidebar">{t.chapters} ☰</button></div>
<aside class="sidebar" id="sidebar">
 <a class="brand" href={link('')}><span class="book-mark" aria-hidden="true">v<span>_</span></span><span>{lang === 'ko' ? <>바이브 코딩<br/>안내서</> : <>The Vibe<br/>Coding Book</>}<span class="edition">{t.edition}</span></span></a>
 <nav aria-label={t.courseChapters}>
  <a class:list={['intro-link',{active:section==='catalog'}]} aria-current={section==='catalog'?'page':undefined} href={link('')}>{catalogTitle}</a>
  <a class:list={['intro-link',{active:section==='news'}]} aria-current={section==='news'?'page':undefined} href={link('news/')}>{newsTitle}</a>
  <details class="course-picker" open={section!=='book'}>
   <summary>{lang==='ko'?'과정 선택':'Choose a course'}{section==='book' && <span>{courseTitle}</span>}</summary>
   <nav aria-label={lang==='ko'?'과정 선택':'Course selection'}>{courseIds.map(id=><a href={link(`courses/${id}/`)} aria-current={section==='book'&&course===id?'true':undefined}>{courses[id][lang].title}</a>)}</nav>
  </details>
  {section==='book' && <>
   <a class:list={['intro-link',{active:current===''}]} aria-current={current===''?'page':undefined} href={link(`courses/${course}/`)}>{t.overview}</a>
   {(course==='vibe-coding'?parts:['chapters']).map((part,i)=><section class="nav-part"><h2>{course==='vibe-coding'?<><span>0{i+1}</span> {t.partNames[i]}</>:t.chapters}</h2><ol>{lessons.filter(l=>course!=='vibe-coding'||('part' in l.data && l.data.part===part)).map(l=><li><a href={link(lessonPath(course,l.id))} class:list={{active:current===l.id}} aria-current={current===l.id?'page':undefined}><span class="lesson-number">{String(l.data.order).padStart(2,'0')}</span><span>{l.data.title}</span></a></li>)}</ol></section>)}
  </>}
 </nav>
 <div class="sidebar-foot">{t.learn}<br/><span>{t.understand}</span></div>
</aside>
<div class="page">
 <header class="topbar">
  <span class="breadcrumb">{t.book} <span class="slash">/</span> {section==='news'?newsTitle:section==='catalog'?catalogTitle:courseTitle}</span>
  <div class="topbar-actions">
   <a class="overview-link" href={section==='book'?link(`courses/${course}/`):link('')+'#curriculum'}>{section==='book'?t.overview:catalogTitle} <span aria-hidden="true">↗</span></a>
   <details class="language-menu">
    <summary>{t.language} <span lang={lang}>{lang === 'ko' ? '한국어' : 'English'}</span> <span aria-hidden="true">⌄</span></summary>
    <nav aria-label={t.languageLabel}>
     <a href={enUrl} lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>English {lang === 'en' && <span aria-hidden="true">✓</span>}</a>
     <a href={koUrl} lang="ko" hreflang="ko" aria-current={lang === 'ko' ? 'true' : undefined}>한국어 {lang === 'ko' && <span aria-hidden="true">✓</span>}</a>
    </nav>
   </details>
  </div>
 </header>
 <div class="reading-layout">
  <main id="main" tabindex="-1"><slot/></main>
  <aside class="toc"><nav aria-label={t.onPage}><h2>{t.onPage}</h2>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav><div class="margin-note">{t.journey}<p>{t.reminder}</p></div></aside>
 </div>
 <footer class="site-footer"><span>{t.book}</span><span>{t.footer}</span></footer>
</div>
<script>
const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
const languageMenu = document.querySelector<HTMLDetailsElement>('.language-menu');
toggle?.addEventListener('click',()=>{const expanded = toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!expanded));document.querySelector('#sidebar')?.classList.toggle('open',!expanded);});
document.addEventListener('keydown',e=>{
 if(e.key!=='Escape') return;
 if(languageMenu?.open){languageMenu.open=false;languageMenu.querySelector('summary')?.focus();}
 else if(toggle?.getAttribute('aria-expanded')==='true'){document.querySelector('#sidebar')?.classList.remove('open');toggle.setAttribute('aria-expanded','false');toggle.focus();}
});
document.addEventListener('click',e=>{if(languageMenu?.open && e.target instanceof Node && !languageMenu.contains(e.target)) languageMenu.open=false;});
</script>
</body></html>
