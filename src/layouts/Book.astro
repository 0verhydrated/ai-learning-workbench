---
import { courses, courseIds, courseLessons, lessonPath, type CourseId } from '../courses';
import { ui, parts, type Language } from '../i18n';
import '../styles/book.css';
import '../styles/courses.css';
import '../styles/reading.css';
import news from '../data/news.json';
import ThemeToggle from '../components/ThemeToggle.astro';
interface Props { title: string; description: string; current?: string; section?: 'book' | 'news' | 'catalog'; course?: CourseId; lang?: Language; headings?: {depth:number;slug:string;text:string}[]; }
const {title, description, current='', section='book', course='vibe-coding', lang='en', headings=[]} = Astro.props;
const newsTitle = lang === 'ko' ? 'AI 뉴스' : 'AI News';
const t = ui[lang];
const lessons = section==='book' ? await courseLessons(course,lang) : [];
const courseTitle=courses[course][lang].title;
const catalogTitle=lang==='ko'?'전체 과정':'All courses';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path: string) => `${base}/${lang === 'ko' ? 'ko/' : ''}${path}`;
const pagePath = section==='news' ? 'news/' : section==='catalog' ? '' : current ? lessonPath(course,current) : `courses/${course}/`;
const enUrl = `${base}/${pagePath}`;
const koUrl = `${base}/ko/${pagePath}`;
---
<!doctype html>
<html lang={lang}>
<head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
 <meta name="description" content={description}/><meta name="color-scheme" content="light dark"/>
 <title>{title} · {t.book}</title><link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml"/>
 <link rel="canonical" href={new URL(lang === 'ko' ? koUrl : enUrl, Astro.site)}/>
 <link rel="alternate" hreflang="en" href={new URL(enUrl, Astro.site)}/>
 <link rel="alternate" hreflang="ko" href={new URL(koUrl, Astro.site)}/>
 <link rel="alternate" hreflang="x-default" href={new URL(enUrl, Astro.site)}/>
 <script is:inline>
  try { const mode=localStorage.getItem('vibe-mode'); if(mode==='light'||mode==='dark') document.documentElement.dataset.mode=mode; } catch {}
 </script>
</head>
<body class:list={{"catalog-page":section==='catalog'}}>
<a class="skip" href="#main">{t.skip}</a>
<header class="site-nav">
 <div class="nav-inner">
  <a class="wordmark" href={link('')} aria-label={t.book}><span class="wordmark-symbol" aria-hidden="true">[v]</span><span>vibe<span class="wordmark-rest"> coding book</span></span></a>
  <nav class="main-nav" aria-label={t.courseChapters}>
   <a href={link('')+'#curriculum'} aria-current={section==='catalog'?'page':undefined}>{lang==='ko'?'과정':'Courses'}</a>
   <a href={link('')+'#playground'}>{lang==='ko'?'직접 해보기':'Playground'}</a>
   <a href={link('news/')}>{newsTitle}</a>
   <a href="https://github.com/0verhydrated/vibe-coding-book">GitHub</a>
  </nav>
  <div class="nav-controls">
   <details class="language-menu">
    <summary aria-label={t.languageLabel}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/></svg><span>{lang==='ko'?'한국어':'English'}</span></summary>
    <nav aria-label={t.languageLabel}>
     <a href={enUrl} lang="en" hreflang="en" aria-current={lang==='en'?'true':undefined}>English</a>
     <a href={koUrl} lang="ko" hreflang="ko" aria-current={lang==='ko'?'true':undefined}>한국어</a>
    </nav>
   </details>
   <ThemeToggle lang={lang}/>
   <button type="button" id="site-menu-toggle" hidden class="icon-button" aria-expanded="false" aria-controls="mobile-nav" aria-label={lang==='ko'?'메뉴 열기':'Open menu'}><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
  </div>
 </div>
 <nav id="mobile-nav" class="mobile-nav" aria-label={lang==='ko'?'모바일 메뉴':'Mobile navigation'} hidden>
  <a href={link('')+'#curriculum'}>{catalogTitle}</a><a href={link('')+'#playground'}>{lang==='ko'?'직접 해보기':'Playground'}</a><a href={link('news/')}>{newsTitle}</a><a href="https://github.com/0verhydrated/vibe-coding-book">GitHub</a>
 </nav>
</header>
<noscript><nav class="no-script-nav" aria-label={t.courseChapters}>{courseIds.map(id=><a href={link(`courses/${id}/`)}>{courses[id][lang].title}</a>)}<a href={link('news/')}>{newsTitle}</a></nav></noscript>
{section!=='catalog' && <>
<div class="mobile-bar"><a href={link('')}>{t.book}</a><button type="button" id="menu-toggle" aria-expanded="false" aria-controls="sidebar">{t.chapters}</button></div>
<aside class="sidebar" id="sidebar">
 <a class="brand" href={link('')}><span class="book-mark" aria-hidden="true">[v]</span><span>{lang === 'ko' ? <>바이브 코딩<br/>안내서</> : <>The Vibe<br/>Coding Book</>}</span></a>
 <nav aria-label={t.courseChapters}>
  <a class="intro-link" href={link('')}>{catalogTitle}</a>

  <details class="course-picker" open={section!=='book'}>
   <summary>{lang==='ko'?'과정 선택':'Choose a course'}{section==='book' && <span>{courseTitle}</span>}</summary>
   <nav aria-label={lang==='ko'?'과정 선택':'Course selection'}>{courseIds.map(id=><a href={link(`courses/${id}/`)} aria-current={section==='book'&&course===id?'true':undefined}>{courses[id][lang].title}</a>)}</nav>
  </details>
  {section==='book' && <>
   <a class:list={['intro-link',{active:current===''}]} aria-current={current===''?'page':undefined} href={link(`courses/${course}/`)}>{t.overview}</a>
   {(course==='vibe-coding'?parts:['chapters']).map((part,i)=><section class="nav-part"><h2>{course==='vibe-coding'?<><span>0{i+1}</span> {t.partNames[i]}</>:t.chapters}</h2><ol>{lessons.filter(l=>course!=='vibe-coding'||('part' in l.data && l.data.part===part)).map(l=><li><a href={link(lessonPath(course,l.id))} class:list={{active:current===l.id}} aria-current={current===l.id?'page':undefined}><span class="lesson-number">{String(l.data.order).padStart(2,'0')}</span><span>{l.data.title}</span></a></li>)}</ol></section>)}
  </>}
 </nav>
</aside>
<div class="page">
 <header class="topbar">
  <span class="breadcrumb">{t.book} <span class="slash">/</span> {section==='news'?newsTitle:courseTitle}</span>
  <div class="topbar-actions"><a class="overview-link" href={section==='book'?link(`courses/${course}/`):link('')+'#curriculum'}>{section==='book'?t.overview:catalogTitle}</a></div>
 </header>
 <div class="reading-layout">
  <main id="main" tabindex="-1"><slot/></main>
  <aside class="toc"><nav aria-label={t.onPage}><h2>{section==='news'?<a href={link('news/')} aria-current="page">{newsTitle}</a>:t.onPage}</h2>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav>{section!=='news' && <section class="news-rail" aria-label={newsTitle}>
   <h2><a href={link('news/')}>{newsTitle}</a></h2>
   <ul>{news.stories.map(story=><li><a href={link('news/')+'#'+story.id}>{story[lang].title}</a></li>)}</ul>
  </section>}</aside>
 </div>
 <footer class="site-footer"><span>{t.book}</span></footer>
</div>
</>}
{section==='catalog' && <main id="main" class="landing-main" tabindex="-1"><slot/></main>}
{section==='catalog' && <footer class="landing-footer container"><a class="wordmark" href={link('')}><span class="wordmark-symbol" aria-hidden="true">[v]</span><span>{t.book}</span></a><p>{lang==='ko'?'직접 만들며, 이해하며 배우세요.':'Learn it. Build it. Understand it.'}</p><nav aria-label={lang==='ko'?'하단 메뉴':'Footer'}><a href={link('')+'#curriculum'}>{catalogTitle}</a><a href={link('news/')}>{newsTitle}</a><a href="https://github.com/0verhydrated/vibe-coding-book">GitHub</a></nav><small>{lang==='ko'?'영어와 한국어로 배우는 실용적인 AI 안내서.':'A practical AI field guide. In English and Korean.'}</small></footer>}
<script>
const siteToggle = document.querySelector<HTMLButtonElement>('#site-menu-toggle');
const mobileNav = document.querySelector<HTMLElement>('#mobile-nav');
if(siteToggle) siteToggle.hidden=false;
siteToggle?.addEventListener('click',()=>{const expanded=siteToggle.getAttribute('aria-expanded')==='true'; siteToggle.setAttribute('aria-expanded',String(!expanded)); if(mobileNav) mobileNav.hidden=expanded;});
mobileNav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{mobileNav.hidden=true;siteToggle?.setAttribute('aria-expanded','false');}));
const toggle = document.querySelector<HTMLButtonElement>('#menu-toggle');
const languageMenu = document.querySelector<HTMLDetailsElement>('.language-menu');
toggle?.addEventListener('click',()=>{const expanded = toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!expanded));document.querySelector('#sidebar')?.classList.toggle('open',!expanded);});
document.addEventListener('keydown',e=>{
 if(e.key!=='Escape') return;
 if(mobileNav && !mobileNav.hidden){mobileNav.hidden=true;siteToggle?.setAttribute('aria-expanded','false');siteToggle?.focus();}
 if(languageMenu?.open){languageMenu.open=false;languageMenu.querySelector('summary')?.focus();}
 else if(toggle?.getAttribute('aria-expanded')==='true'){document.querySelector('#sidebar')?.classList.remove('open');toggle.setAttribute('aria-expanded','false');toggle.focus();}
});
document.addEventListener('click',e=>{if(languageMenu?.open && e.target instanceof Node && !languageMenu.contains(e.target)) languageMenu.open=false;});
</script>
</body></html>
<style is:global>
html, body { overflow-x: clip; }
</style>
