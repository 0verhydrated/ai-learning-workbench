---
import Book from './Book.astro';
import WorkflowDemo from '../components/WorkflowDemo.astro';
import {courses,courseIds,courseLessons,lessonPath} from '../courses';
import type {Language} from '../i18n';
import news from '../data/news.json';
interface Props {lang?:Language;}
const {lang='en'}=Astro.props; const ko=lang==='ko';
const base=import.meta.env.BASE_URL.replace(/\/$/,'')+(ko?'/ko':'');
const entries=await Promise.all(courseIds.map(async id=>({id,...courses[id][lang],lessons:await courseLessons(id,lang)})));
const descriptions=ko?['모델, 토큰, 맥락과 검색을 이해하세요.','독서 목록 앱을 만들고 검증하고 배포하세요.','MCP, 도구, 스킬, 메모리를 연결하세요.','반복 작업을 예약하고 실패에 대비하세요.']:['Understand models, tokens, context, and retrieval.','Build, test, and deploy a reading-list app.','Connect MCP, tools, skills, and memory.','Schedule workflows and recover from failures.'];
const specimens=['model + context\n= response','const app = build(idea);\ntest(app);\ndeploy(app);','weekly-report/\n  SKILL.md\n  references/','on: schedule\nsteps:\n  - verify sources\n  - prepare draft'];
---
<Book lang={lang} section="catalog" title={ko?'AI를 내 편으로':'Put AI to work'} description={ko?'모델의 원리부터 MCP, 스킬, 도구와 자동화까지 직접 만들어 배우세요.':'Learn to put AI to work with practical courses in models, MCP, skills, tools, and automation.'}>
 <section class="hero container">
  <div class="opening-copy">
   <h1>{ko?<>바이브 코딩.<br/>프롬프트 그 너머.</>:<>Vibe coding.<br/>Beyond the prompt.</>}</h1>
   <p class="lead">{ko?'모델, 도구, MCP, 스킬을 활용하는 법을 직접 만들며 배우세요.':'Learn to build with models, tools, MCP, and reusable skills.'}</p>
   <div class="hero-actions"><a class="button-primary" href={`${base}/courses/ai-foundations/01-models/`}>{ko?'학습 시작하기':'Start learning'}<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></a><a class="quiet-link" href="#curriculum">{ko?'과정 살펴보기':'Explore the courses'}</a></div>
  </div>
  <WorkflowDemo lang={lang}/>
 </section>
 <section id="curriculum" class="course-section container">
  <div class="section-intro"><h2>{ko?'원리에서 실제 활용까지.':'From “what if” to working.'}</h2><a class="quiet-link" href="#learning-path">{ko?'어디서 시작할까요?':'Find your starting point'}</a></div>
  <div class="course-grid">
   {entries.map((course,i)=><article class:list={['course-tile',`course-${course.id}`]}>
    <div class="course-art" aria-hidden="true"><pre><code>{specimens[i]}</code></pre><div class="art-file">{['context.txt','app.js','SKILL.md','workflow.yml'][i]}</div></div>
    <div class="course-tile-copy"><h3><a href={`${base}/courses/${course.id}/`}>{course.title}</a></h3><p class="course-level"><span>{course.level}</span><span>{course.lessons.length}{ko?'개 강의':' lessons'}</span></p><p>{descriptions[i]}</p><details class="course-detail"><summary>{ko?'다루는 주제':'What’s inside'}</summary><p>{course.description}</p></details><p class="course-topics">{course.topics.split(' · ').join(', ')}</p><div class="course-actions"><a class="text-link" href={`${base}/courses/${course.id}/`}>{ko?'과정 살펴보기':'View course'}<span aria-hidden="true">↗</span></a>{course.lessons[0]&&<a href={`${base}/${lessonPath(course.id,course.lessons[0].id)}`}>{ko?'첫 강의 읽기':'First lesson'}</a>}</div></div>
   </article>)}
  </div>
 </section>
 <section class="learning-section container" id="learning-path">
  <div class="learning-copy"><h2>{ko?'작게 만들고.\n제대로 이해하세요.':'Small projects.\nReal understanding.'}</h2><p>{ko?'각 강의에는 설명과 예제, 직접 해 볼 실습이 있습니다.':'Every lesson pairs an explanation with a worked example and an exercise.'}</p><a class="text-link" href={`${base}/lessons/01-fundamentals/`}>{ko?'첫 프로젝트 시작하기':'Build your first project'}<span aria-hidden="true">↗</span></a></div>
  <div class="learning-routes"><a href={`${base}/courses/ai-foundations/`}><h3>{ko?'AI가 처음이라면':'New to AI?'}</h3><p>{ko?'모델과 맥락부터 차근차근.':'Start with models and context.'}</p><span aria-hidden="true">↗</span></a><a href={`${base}/courses/vibe-coding/`}><h3>{ko?'일단 만들어 보고 싶다면':'Ready to make something?'}</h3><p>{ko?'작은 브라우저 앱으로 시작하세요.':'Take a small browser app from idea to deployment.'}</p><span aria-hidden="true">↗</span></a><a href={`${base}/courses/agents-tools/`}><h3>{ko?'도구를 연결하고 싶다면':'Want AI to do more?'}</h3><p>{ko?'도구를 연결하기 전에 에이전트와 권한을 이해하세요.':'Learn agent loops and permissions before connecting tools.'}</p><span aria-hidden="true">↗</span></a><a href={`${base}/courses/automation/`}><h3>{ko?'반복 작업을 맡기려면':'Making it repeatable?'}</h3><p>{ko?'예약 전에 범위와 검증 방법을 정하세요.':'Set boundaries and verify outputs before scheduling.'}</p><span aria-hidden="true">↗</span></a></div>
 </section>
 <section class="practice-section container"><h2>{ko?'읽고 끝내지 마세요.':'Keep a hand on the controls.'}</h2><div class="practice-body"><p>{ko?'예제를 내 컴퓨터에서 실행하고, 결과를 살펴보고, 왜 그렇게 작동하는지 확인하세요.':'Run examples locally. Inspect the result. Understand what changed.'}</p><p>{ko?'외부 계정, 권한, 유료 API가 필요한 단계는 강의에서 구분해 안내합니다.':'Lessons explain when an integration needs an account, permissions, or paid API calls.'}</p><a class="text-link" href={`${base}/courses/agents-tools/02-mcp/`}>{ko?'첫 MCP 연결 이해하기':'Understand your first MCP connection'}<span aria-hidden="true">↗</span></a></div></section>
 <section class="news-rail" aria-label={ko?'AI 뉴스':'AI News'}><div class="news-section container">
  <div class="section-intro"><h2>{ko?'배운 것을, 이번 주에.':'Put this week’s AI to use.'}</h2><a class="text-link" href={`${base}/news/`}>{ko?'AI 뉴스 읽기':'Read AI News'}<span aria-hidden="true">↗</span></a></div>
  <div class="news-grid">{news.stories.map(story=><article><p class="news-date"><time datetime={story.publishedAt}>{story.publishedAt}</time><span>{story.source.name}</span></p><h3><a href={`${base}/news/#${story.id}`}>{story[lang].title}</a></h3><a class="text-link" href={`${base}/news/#${story.id}`}>{ko?'읽고 실습하기':'Read and try'}<span aria-hidden="true">↗</span></a></article>)}</div>
 </div></section>
</Book>
